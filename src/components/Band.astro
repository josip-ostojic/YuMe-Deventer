---
// The white band with logo and sushi between two wave strips: the cover of their printed menu card.
---
<section aria-label="YuMe Sushi & Grill" class="bg-ink">
  <div class="wave h-12 opacity-70 md:h-20" aria-hidden="true"></div>
  <div class="overflow-hidden bg-white">
    <img
      src="/images/brand-band.webp"
      width="1600"
      height="408"
      alt="YuMe Sushi & Grill, met sushi tussen eetstokjes"
      loading="lazy"
      decoding="async"
      data-band-img
      class="relative left-1/2 block h-auto w-[max(100%,640px)] max-w-none [transform:translateX(calc(-50%_+_var(--bx,0px)))] will-change-transform"
    />
  </div>
  <div class="wave h-12 opacity-70 md:h-20" aria-hidden="true"></div>
</section>
