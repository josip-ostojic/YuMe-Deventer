---
import { biz, routeHref, foodtownHref } from '../../lib/data';
import { takeaway } from '../../lib/order';
const zones = takeaway.delivery_zones;
const eur = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: 2 });
---
<section class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-x-[-12%] inset-y-[-8%] -z-20" aria-hidden="true">
    <div data-parallax class="h-full w-full"><div class="hero-wave wave h-full w-full"></div></div>
  </div>
  <div class="hero-photo -z-10 md:!w-[48%]">
    <img src="/images/table.webp" width="1024" height="576" alt="" fetchpriority="high" decoding="async" class="h-full w-full object-cover" />
  </div>

  <div class="wrap pb-12 pt-28 md:pb-16 md:pt-36">
    <p class="o-concept hero-line" style="--d:.2s">
      Conceptontwerp: zo kan bestellen er hier uitzien. Echt bestellen en betalen doet u op{' '}
      <a href={foodtownHref} rel="noopener">foodtown.nl</a>.
    </p>
    <h1 class="hero-line mt-6 text-[clamp(3.2rem,9vw,7rem)] leading-[0.95]" style="--d:.45s">Bestel online</h1>
    <p class="hero-line mt-5 max-w-md text-lg text-paper/85 md:text-xl" style="--d:.7s">
      Afhalen of laten bezorgen. Sushi, grill en meer van de afhaalkaart.
    </p>

    <div class="o-mode hero-line mt-9 max-w-xl" id="order" style="--d:.95s"
      data-zones={JSON.stringify(zones.map((z) => ({ name: z.name, fee: z.fee_eur, min: z.minimum_eur, codes: z.postcodes })))}
      data-hours={JSON.stringify(takeaway.pickup_hours)}
      data-min-takeaway={takeaway.minimum_takeaway_eur}
      data-foodtown={foodtownHref}
      data-phone={biz.phone}
      data-phone-tel={biz.phone_tel}
    >
      <div class="o-seg" role="radiogroup" aria-label="Afhalen of bezorgen">
        <span class="o-seg-pill" aria-hidden="true"></span>
        <button type="button" role="radio" aria-checked="true" data-mode="pickup">Afhalen</button>
        <button type="button" role="radio" aria-checked="false" data-mode="delivery">Bezorgen</button>
      </div>

      <div class="o-panel" data-panel="pickup">
        <div>
          <p class="pt-5 text-paper/90">
            Afhalen aan het {biz.address.street} in {biz.address.city}.{' '}
            <a href={routeHref} class="text-gold underline underline-offset-4 hover:text-paper" rel="noopener">Route plannen</a>
          </p>
        </div>
      </div>

      <div class="o-panel" data-panel="delivery" hidden>
        <div>
          <label for="o-zip" class="mt-5 block text-paper/90">Uw postcode</label>
          <div class="mt-2 flex items-center gap-3">
            <input id="o-zip" class="o-zip" inputmode="text" autocomplete="postal-code" maxlength="7" placeholder="7411 EH" spellcheck="false" />
            <span class="o-zip-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" class="ring" /><path d="M7.500 12.500l3 3 6-7" class="tick" /><path d="M8.500 8.500l7 7M15.500 8.500l-7 7" class="cross" />
              </svg>
            </span>
          </div>
          <p class="o-zip-status mt-3 min-h-[3rem] text-paper/90" data-zip-status aria-live="polite">Vul uw postcode in om te zien of we bezorgen.</p>
          <details class="o-zones mt-2">
            <summary>Bezorggebieden en kosten</summary>
            <ul class="mt-3 space-y-3 text-sm text-paper/80">
              {zones.map((z) => (
                <li>
                  <strong class="font-medium text-paper">{z.name}</strong>: bezorgkosten {eur(z.fee_eur)}, minimaal {eur(z.minimum_eur)}.
                  <span class="block text-paper/60">Postcodes {z.postcodes.map((p) => p.replace('-', ' t/m ')).join(', ')}.</span>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>

      <p class="o-status mt-6 flex items-center gap-3 border-t border-line pt-4 text-[0.98rem]">
        <span class="h-2 w-2 shrink-0 rounded-full bg-muted/50 data-[open]:bg-gold" aria-hidden="true" data-status-dot></span>
        <span data-order-status>Bestellen kan dinsdag t/m zondag, maandag gesloten.</span>
      </p>
    </div>
  </div>
</section>
