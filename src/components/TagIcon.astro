---
// Small line icons for the tags Foodtown shows. Labelled for screen readers.
interface Props { tag: string; class?: string }
const { tag, class: cls = '' } = Astro.props;
const label = ({ fish: 'Bevat vis', shellfish: 'Bevat schaaldieren', egg: 'Bevat ei', vegetarian: 'Vegetarisch', halal: 'Halal' } as Record<string, string>)[tag] ?? tag;
---
<svg viewBox="0 0 24 24" width="20" height="20" role="img" aria-label={label} class:list={['tag-icon', cls]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  <title>{label}</title>
  {tag === 'fish' && (<><path d="M3 12c3-5 9-6 13-2.500l5-3v11l-5-3C12 17.500 6 17 3 12z" /><circle cx="8" cy="11.500" r=".6" fill="currentColor" stroke="none" /></>)}
  {tag === 'shellfish' && (<><path d="M5 17c-1-6 3-11 10-10 3 .5 4.500 2.500 4.500 5-2-1.500-4-1-5 .5 1.500 1 1.500 3.500-.5 5-2 1.500-5.500 1.500-8-.5" /><path d="M9 8l-2-3M12 7.500l-.5-3" /></>)}
  {tag === 'egg' && <path d="M12 3c4 0 6.500 6 6.500 10a6.500 6.500 0 0 1-13 0C5.500 9 8 3 12 3z" />}
  {tag === 'vegetarian' && (<><path d="M5 19C5 10 10 5 19 5c0 9-5 14-14 14z" /><path d="M5 19c3-5 6-8 9-9" /></>)}
  {tag === 'halal' && <path d="M15.500 4a8 8 0 1 0 4.500 12.500A7 7 0 0 1 15.500 4z" />}
</svg>
