---
import { c, biz, eur, routeHref } from '../lib/data';
const p = c.parking;
const nearby = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`parkeren nabij ${biz.address.street}, ${biz.address.postalCode} ${biz.address.city}`);
---
<section id="parkeren" class="section pt-32 md:pt-44">
  <div class="wrap">
    <h1 class="h2">Parkeren</h1>
    <p class="lead mt-5">Gasten van het restaurant betalen minder voor parkeren.</p>

    <div class="mt-12 grid border-t border-line md:grid-cols-2">
      {p.rates.map((r, i) => {
        const save = r.normal_eur - r.with_yume_eur;
        return (
          <div class={`py-8 md:py-10 ${i === 0 ? 'md:pr-10' : 'border-t border-line md:border-l md:border-t-0 md:pl-10'}`}>
            <h2 class="font-sans text-lg font-normal tracking-normal text-muted">{r.duration}</h2>
            <p class="mt-2 font-display text-6xl leading-none md:text-7xl">{eur(r.with_yume_eur)}</p>
            <p class="mt-3 text-muted">met YuMe, normaal <s>{eur(r.normal_eur)}</s></p>
            <p class="mt-2 inline-block border border-gold/60 px-2.5 py-1 text-sm text-gold">U scheelt {eur(save)}</p>
          </div>
        );
      })}
    </div>

    <div class="border-t border-line pt-8">
      <div class="flex flex-wrap gap-3">
        <a href={nearby} class="btn btn-solid" rel="noopener">Parkeren in de buurt</a>
        <a href={routeHref} class="btn btn-line" rel="noopener">Route plannen</a>
        <a href="https://www.q-park.nl/" class="btn btn-line" rel="noopener">Naar Q-Park</a>
      </div>
      <p class="mt-6 max-w-xl text-muted">Waar u kunt parkeren en hoe ver het lopen is, staat op de website van Q-Park.</p>
      <p class="mt-3 text-sm text-muted">
        <span class="border border-dashed border-gold/60 px-1.5 py-0.5 text-gold">[TODO]</span>
        Naam van de garage, loopafstand en hoe u de korting krijgt.
      </p>
    </div>
  </div>
</section>
